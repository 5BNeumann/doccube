:: Widgets [widget]

<!-- @doc registerfunc
<!-- @kind func
<!-- @desc Registers a function to the list.
-->
<<widget "registerfunc">>
	<<run $funcs.push(_args[0])>>
	<<run $allsymbols.push(_args[0])>>
<</widget>>

<!-- @doc registertype
<!-- @kind func
<!-- @desc Registers a type to the list.
-->
<<widget "registertype">>
	<<run $types.push(_args[0])>>
	<<run $allsymbols.push(_args[0])>>
<</widget>>

<!-- @doc registersan
<!-- @kind func
<!-- @desc Registers a sanity to the list.
-->
<<widget "registersan">>
	<<run $sans.push(_args[0])>>
	<<run $allsymbols.push(_args[0])>>
<</widget>>

<!-- @doc registerfile
<!-- @kind func
<!-- @desc Registers a file to the list.
-->
<<widget "registerfile">>
	<<set $files.push(_args[0] + "-file")>>
	<<run $allsymbols.push(_args[0]) + "-file">>
<</widget>>

<!-- @doc listfuncs
<!-- @kind func
<!-- @desc Displays the list of documented functions.
-->
<<widget "listfuncs">>
	<h2>Functions</h2>
	<<for _i, _func range $funcs>>
		<<link _func _func>><</link>>
	<</for>>
<</widget>>

<!-- @doc listtypes
<!-- @kind func
<!-- @desc Displays the list of documented types.
-->
<<widget "listtypes">>
	<h2>Types</h2>
	<<for _i, _type range $types>>
		<<link _type _type>><</link>>
	<</for>>
<</widget>>

<!-- @doc listsans
<!-- @kind func
<!-- @desc Displays the list of documented sanities.
-->
<<widget "listsans">>
	<h2>Sanity</h2>
	<<for _i, _san range $sans>>
		<<set _vname to _san.substr(0, _san.indexOf("-"))>>
		<<link _vname _san>><</link>>
	<</for>>
<</widget>>

<!-- @doc listfiles
<!-- @kind func
<!-- @desc Displays the list of documented files.
-->
<<widget "listfiles">>
	<h2>Files</h2>
	<<for _i, _file range $files>>
		<<set _vname to _file.replace("-file", "")>>
		<<link _vname _file>><</link>>
	<</for>>
<</widget>>

<<widget "search">>
	<h3>Search</h3>
	<<textbox "$search" "" "Searchresult">>
<</widget>>
